<?xml version="1.0" encoding="UTF-8"?>
<Defs>

    <ProjectSilverSquad.BrainChipDef Name="SilverSquad_ChipBase" ParentName="ResourceBase" Abstract="True">
        <stackLimit>1</stackLimit>
        <graphicData>
            <texPath>ProjectSilverSquad/Items/Chips/Chip</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <shaderType>CutoutComplex</shaderType>
            <drawSize>(0.9,0.9)</drawSize>
        </graphicData>
        <statBases>
            <MarketValue>400</MarketValue>
            <MaxHitPoints>100</MaxHitPoints>
            <Flammability>1.0</Flammability>
            <WorkToMake>2000</WorkToMake>
            <DeteriorationRate>2</DeteriorationRate>
            <Mass>0.03</Mass>
        </statBases>
        <thingCategories>
            <li>ItemsMisc</li>
        </thingCategories>
        <recipeMaker>
            <researchPrerequisite>SilverSquad_CloningTech</researchPrerequisite>
            <recipeUsers>
                <li>SilverSquad_ChipWorkbench</li>
            </recipeUsers>
            <effectWorking>Cook</effectWorking>
            <soundWorking>Recipe_Machining</soundWorking>
            <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
        </recipeMaker>
        <allowedArchonexusCount>5</allowedArchonexusCount>
        <comps>
            <li>
                <compClass>CompColorable</compClass>
            </li>
        </comps>
    </ProjectSilverSquad.BrainChipDef>

    <ProjectSilverSquad.BrainChipDef ParentName="SilverSquad_ChipBase">
        <defName>SilverSquad_BrainChip_BlankBase</defName>
        <label>Cloning configuration disk</label>
        <description>A disk containing that can hold instructions readable by a cloning vat.\n\nWhen empty, it has the capability of copying the data of other disk. Otherwise, it can be slotted into the cloning vat to modify the characteristics of a clone.</description>
        <thingClass>ProjectSilverSquad.ThingClass_BrainChip</thingClass>
        <recipeMaker>
            <skillRequirements>
                <Crafting>5</Crafting>
            </skillRequirements>
        </recipeMaker>
        <costList> <!-- Probably buff this, too cheap? -->
            <Steel>30</Steel>
            <ComponentIndustrial>1</ComponentIndustrial>
        </costList>
        <chanceForHybridGeneratedChip>1</chanceForHybridGeneratedChip>
        <chanceForSkillVsTraitChip>0.5</chanceForSkillVsTraitChip>
        <chanceForCloningVatParameters>0.3</chanceForCloningVatParameters>
        <randomTraitCount>1~5</randomTraitCount>
        <randomSkillCount>1~3</randomSkillCount>

        <randomInstabilityOffset>-1~1</randomInstabilityOffset>
        <randomInstabilityFactor>0.1~3</randomInstabilityFactor>
        <randomEmbryoGrowingTimeTicksOffset>0~100000</randomEmbryoGrowingTimeTicksOffset>
        <randomPawnGrowingTimeTicksOffset>0~200000</randomPawnGrowingTimeTicksOffset>
        <randomEmbryoGrowingTimeFactor>0.1~3</randomEmbryoGrowingTimeFactor>
        <randomPawnGrowingTimeFactor>0.1~3</randomPawnGrowingTimeFactor>
    </ProjectSilverSquad.BrainChipDef>
    
</Defs>